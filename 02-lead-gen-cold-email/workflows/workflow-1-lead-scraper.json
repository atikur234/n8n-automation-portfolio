{
  "name": "Workflow 1 - Lead Scraper (Google Maps to Sheets)",
  "nodes": [
    {
      "parameters": {},
      "id": "b1a1e001-0001-4001-8001-000000000001",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        -560,
        300
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "cfg-niche",
              "name": "search_query",
              "value": "dentists in Los Angeles",
              "type": "string"
            },
            {
              "id": "cfg-max",
              "name": "max_results",
              "value": 50,
              "type": "number"
            }
          ]
        },
        "options": {}
      },
      "id": "b1a1e001-0002-4002-8002-000000000002",
      "name": "CONFIG - Edit Me",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -340,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.apify.com/v2/acts/compass~crawler-google-places/run-sync-get-dataset-items",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "token",
              "value": "YOUR_APIFY_TOKEN"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"searchStringsArray\": [\"{{ $json.search_query }}\"],\n  \"maxCrawledPlacesPerSearch\": {{ $json.max_results }},\n  \"language\": \"en\",\n  \"skipClosedPlaces\": true\n}",
        "options": {
          "timeout": 300000
        }
      },
      "id": "b1a1e001-0003-4003-8003-000000000003",
      "name": "Apify - Google Maps Scraper",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -100,
        300
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "map-business_name",
              "name": "business_name",
              "value": "={{ $json.title }}",
              "type": "string"
            },
            {
              "id": "map-website",
              "name": "website",
              "value": "={{ $json.website || '' }}",
              "type": "string"
            },
            {
              "id": "map-phone",
              "name": "phone",
              "value": "={{ $json.phone || '' }}",
              "type": "string"
            },
            {
              "id": "map-rating",
              "name": "rating",
              "value": "={{ $json.totalScore || '' }}",
              "type": "string"
            },
            {
              "id": "map-review_count",
              "name": "review_count",
              "value": "={{ $json.reviewsCount || 0 }}",
              "type": "number"
            },
            {
              "id": "map-address",
              "name": "address",
              "value": "={{ $json.address || '' }}",
              "type": "string"
            },
            {
              "id": "map-category",
              "name": "category",
              "value": "={{ $json.categoryName || '' }}",
              "type": "string"
            },
            {
              "id": "map-source",
              "name": "source",
              "value": "Google Maps",
              "type": "string"
            },
            {
              "id": "map-status",
              "name": "status",
              "value": "new",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "b1a1e001-0004-4004-8004-000000000004",
      "name": "Map Fields",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        140,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "has-contact",
              "leftValue": "={{ $json.website }}{{ $json.phone }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "b1a1e001-0005-4005-8005-000000000005",
      "name": "Filter - Has Contact Info",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.2,
      "position": [
        380,
        300
      ]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "YOUR_GOOGLE_SHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Leads",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "autoMapInputData",
          "value": {},
          "matchingColumns": [],
          "schema": []
        },
        "options": {}
      },
      "id": "b1a1e001-0006-4006-8006-000000000006",
      "name": "Google Sheets - Append Leads",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        620,
        300
      ]
    }
  ],
  "connections": {
    "Manual Trigger": {
      "main": [
        [
          {
            "node": "CONFIG - Edit Me",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "CONFIG - Edit Me": {
      "main": [
        [
          {
            "node": "Apify - Google Maps Scraper",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Apify - Google Maps Scraper": {
      "main": [
        [
          {
            "node": "Map Fields",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Map Fields": {
      "main": [
        [
          {
            "node": "Filter - Has Contact Info",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Filter - Has Contact Info": {
      "main": [
        [
          {
            "node": "Google Sheets - Append Leads",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}